{:paths ["src"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/io-ipld
        {:git/sha "48ba40490cf082a1473986ac757b8e2b214a3d1b"}
        io.github.kotoba-lang/io-multiformats
        {:git/sha "561fe7dfada3db852b127f06d41750dabd3cead9"}
        io.github.kotoba-lang/merkle-lsm
        {:git/sha "401b79985ca081b497c3cc3ddfb241c4f0ab04fe"}
        ;; Reader half of ADR-2608060500. `decode-node` is the identity on
        ;; every block written so far, so nothing changes today — it makes
        ;; this library able to read a compressed materialized-view block,
        ;; which has to be true everywhere before anything writes one.
        io.github.kotoba-lang/kotobase-block-codec
        {:git/sha "3ec88f11e7b35efd7f592f52c511a067d50bf096"}}
 :aliases
 {:test {:extra-paths ["test"]
         ;; **No kotobase-peer here, and that is the point.** peer's `:deps`
         ;; include this repo, so a peer dependency here — even test-scoped —
         ;; is a cycle, and a cycle cannot be pin-consistent: each side can
         ;; only name a slightly older revision of the other. Measured
         ;; 2026-08-18, pointing this alias at peer's current main pushed the
         ;; conflicting-pin count from eight pairs to seventeen, because the
         ;; traversal re-enters at a new version each way round.
         ;;
         ;; The tests that needed a real store moved to peer, where the
         ;; dependency runs the way it already did
         ;; (`kotobase-peer.projection-datalog-test`).
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
